FROM ghcr.io/cirruslabs/flutter:stable

USER root
WORKDIR /opt/aplus-agent

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       python3 python3-pip git ca-certificates openjdk-17-jdk-headless \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m pip install --break-system-packages --no-cache-dir \
       'requests>=2.32,<3' 'PyJWT[crypto]>=2.10,<3'

COPY agents /opt/aplus-agent/agents

ENV PYTHONUNBUFFERED=1 \
    PUBLISHER_CONTINUOUS=1 \
    PUBLISHER_POLL_INTERVAL=5 \
    PUBLISHER_MAX_JOBS=1000000 \
    PUBLISHER_WORK_ROOT=/work \
    PUB_CACHE=/cache/pub \
    GRADLE_USER_HOME=/cache/gradle

RUN mkdir -p /work /cache/pub /cache/gradle

CMD ["python3", "agents/cloud_linux.py"]
